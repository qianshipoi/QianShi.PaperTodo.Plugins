<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- InternalsVisibleTo in the plugin project names exactly this assembly. -->
    <AssemblyName>QianShi.PaperTodo.Archive.Checks</AssemblyName>
    <RootNamespace>QianShi.PaperTodo.Archive.Checks</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\QianShi.PaperTodo.Archive\QianShi.PaperTodo.Archive.csproj" />
  </ItemGroup>
  <!-- No PackageReference on purpose: the checks must build and run offline. -->
</Project>
